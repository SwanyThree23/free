# ==================================
# SwanyThree Ultimate Platform
# Environment Configuration
# ==================================

# Application Settings
NODE_ENV=production
APP_URL=https://your-domain.com
PORT=5678

# Database Configuration
DB_TYPE=postgresdb
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=n8n
DB_USER=n8n_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD

# N8N Configuration
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING
N8N_PROTOCOL=https
N8N_HOST=your-domain.com
N8N_PORT=5678

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Settings
MAX_FILE_SIZE=500MB
ALLOWED_FILE_TYPES=video/*,image/*,audio/*,application/pdf

# ==================================
# AI Services
# ==================================

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
ANTHROPIC_MODEL=claude-3-opus-20240229
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT=300000

# OpenAI (Fallback)
OPENAI_API_KEY=sk-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4

# ==================================
# Cloud Services - AWS
# ==================================

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1

# S3 Storage
AWS_S3_BUCKET=swanythree-assets
AWS_S3_REGION=us-east-1

# CloudWatch Logging
AWS_CLOUDWATCH_LOG_GROUP=/swanythree/production
AWS_CLOUDWATCH_LOG_STREAM=n8n

# ==================================
# Platform Integrations
# ==================================

# YouTube
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
YOUTUBE_REDIRECT_URI=https://your-domain.com/oauth/youtube/callback

# LinkedIn
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_REDIRECT_URI=https://your-domain.com/oauth/linkedin/callback

# Twitter/X
TWITTER_API_KEY=YOUR_TWITTER_API_KEY
TWITTER_API_SECRET=YOUR_TWITTER_API_SECRET
TWITTER_ACCESS_TOKEN=YOUR_TWITTER_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=YOUR_TWITTER_ACCESS_SECRET
TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN

# Instagram (via Facebook Graph API)
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN

# Facebook
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
FACEBOOK_ACCESS_TOKEN=YOUR_FACEBOOK_ACCESS_TOKEN

# TikTok
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET

# WordPress
WORDPRESS_SITE_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=YOUR_WORDPRESS_USERNAME
WORDPRESS_APP_PASSWORD=YOUR_WORDPRESS_APP_PASSWORD

# Shopify
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=YOUR_SHOPIFY_ACCESS_TOKEN
SHOPIFY_API_KEY=YOUR_SHOPIFY_API_KEY
SHOPIFY_API_SECRET=YOUR_SHOPIFY_API_SECRET

# Stripe
STRIPE_API_KEY=sk_live_YOUR_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# HubSpot
HUBSPOT_API_KEY=YOUR_HUBSPOT_API_KEY
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_ACCESS_TOKEN

# Mailchimp
MAILCHIMP_API_KEY=YOUR_MAILCHIMP_API_KEY
MAILCHIMP_SERVER_PREFIX=us1

# ==================================
# Monitoring & Analytics
# ==================================

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
GRAFANA_API_KEY=YOUR_GRAFANA_API_KEY

# Prometheus
PROMETHEUS_RETENTION_DAYS=30

# Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#alerts

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD
ALERT_EMAIL_FROM=alerts@your-domain.com
ALERT_EMAIL_TO=admin@your-domain.com

# Sentry Error Tracking
SENTRY_DSN=https://YOUR_SENTRY_DSN

# ==================================
# Security Settings
# ==================================

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# CORS
CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com

# Security Headers
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# ==================================
# Feature Flags
# ==================================

# Agent Swarm
ENABLE_AGENT_SWARM=true
MAX_CONCURRENT_AGENTS=10

# MCP Servers
ENABLE_MCP_SERVERS=true

# Multi-User
ENABLE_MULTI_USER=true
ENABLE_TEAM_COLLABORATION=true

# Content Waterfall
ENABLE_CONTENT_WATERFALL=true
MAX_WATERFALL_ASSETS=50

# Industry Awareness
ENABLE_INDUSTRY_DETECTION=true
INDUSTRY_CONFIDENCE_THRESHOLD=0.70

# ==================================
# Development/Testing
# ==================================

# Debug
DEBUG=false
LOG_LEVEL=info

# Testing
ENABLE_TEST_MODE=false
MOCK_AI_RESPONSES=false

# ==================================
# Backup Configuration
# ==================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=swanythree-backups
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# ==================================
# Performance Tuning
# ==================================

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Connection Pool
REDIS_POOL_MIN=2
REDIS_POOL_MAX=20

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_MAX_JOBS=100

# Cache TTL (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600

# ==================================
# Notes
# ==================================

# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to version control
# 3. Use strong, randomly generated passwords and secrets
# 4. Rotate secrets regularly (monthly recommended)
# 5. Use environment-specific configurations for dev/staging/prod
# 6. Store production secrets in a secure vault (AWS Secrets Manager, etc.)

# Generate random secrets with:
# openssl rand -hex 32  (for 64-character hex string)
# openssl rand -base64 32  (for 44-character base64 string)
